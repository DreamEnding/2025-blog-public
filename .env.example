SITE_PORT=3000
SITE_URL=http://localhost:3000
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
SESSION_SECRET=replace-with-at-least-32-random-characters
RSSHUB_URL=http://127.0.0.1:1200
# Optional legacy defaults. Configure Cookie and proxies in Admin > RSS instead.
ZHIHU_COOKIES=
# Admin changes take priority. In Docker, 127.0.0.1 means the container itself.
RSS_FETCH_PROXY=
RSSHUB_PROXY_URI=
